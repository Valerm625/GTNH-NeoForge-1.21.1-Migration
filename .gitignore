# Whitelist source and evidence; runtime/game data never belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/STATUS.zh-CN.md
!/RESUME.md
!/PAUSED-HANDOFF.zh-CN.md
!/NOTICE.md
!/requirements.txt
!/checkpoint-manifest.json
!/docs/
!/evidence/
!/locks/
!/work/
/work/*
!/work/migration/
!/work/compat-mod/
/work/migration/*
!/work/migration/*.py
!/work/migration/*.cjs
!/work/migration/*.java
/work/compat-mod/*
!/work/compat-mod/src/
**/__pycache__/
**/*.pyc
**/*.class
**/*.jar
**/*.zip
**/*.exe
**/*.dll
**/*.png
**/*.ogg
**/.env*
**/credentials*
