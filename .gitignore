# Whitelist source and evidence; runtime/game data never belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/STATUS.zh-CN.md
!/RESUME.md
!/PAUSED-HANDOFF.zh-CN.md
!/NOTICE.md
!/requirements.txt
!/checkpoint-manifest.json
!/docs/
!/evidence/
!/locks/
!/work/
/work/*
!/work/migration/
!/work/compat-mod/
/work/migration/*
!/work/migration/*.py
!/work/migration/*.cjs
!/work/migration/*.java
!/work/migration/KubeJSBridgeFixtures.js
# Local third-party inspection inputs restored from the private checkpoint.
/work/migration/GTRecipeSchema.java
/work/migration/MaterialIconSet.java
/work/migration/MaterialIconType.java
/work/migration/OreBlockRenderer.java
/work/migration/OreProperty.java
/work/compat-mod/*
!/work/compat-mod/src/
!/work/compat-mod/patches/
**/__pycache__/
**/*.pyc
**/*.class
**/*.jar
**/*.zip
**/*.exe
**/*.dll
**/*.png
**/*.ogg
**/.env*
**/credentials*
